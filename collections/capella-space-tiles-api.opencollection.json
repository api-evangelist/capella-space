{
  "opencollection": "1.0.0",
  "info": {
    "name": "Capella Space Collects Tiles API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tiles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List tiles for a tasking request",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.capellaspace.com/tiles/list/:taskingrequestId",
            "params": [
              {
                "name": "taskingrequestId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List tiles for a tasking request"
        }
      ]
    }
  ],
  "bundled": true
}