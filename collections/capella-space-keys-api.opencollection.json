{
  "opencollection": "1.0.0",
  "info": {
    "name": "Capella Space Collects Keys API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Keys",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Request an API key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.capellaspace.com/keys"
          },
          "docs": "Request an API key"
        }
      ]
    }
  ],
  "bundled": true
}